<Window x:Class="ERP.Restaurant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ERP Restaurant - Sistema de Gestión" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú Lateral -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel>
                <TextBlock Text="🍽️ ERP Restaurant" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="White"
                           Margin="15,20,15,30"/>
                
                <Button x:Name="BtnPOS" Content="🛒  Punto de Venta" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnPOS_Click"/>
                
                <Button x:Name="BtnCompras" Content="📦  Compras" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnCompras_Click"/>
                
                <Button x:Name="BtnCRM" Content="👥  Clientes / CRM" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnCRM_Click"/>
                
                <Button x:Name="BtnRecetas" Content="🍽️  Recetas / Costos" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnRecetas_Click"/>
                
                <Button x:Name="BtnReportes" Content="📊  Reportes" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnReportes_Click"/>
                
                <Button x:Name="BtnImpresoras" Content="🖨️  Impresoras" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalContentAlignment="Left"
                        Height="50" Click="BtnImpresoras_Click"/>
                
                <StackPanel VerticalAlignment="Bottom" Margin="15,0,15,20">
                    <TextBlock x:Name="TxtUsuario" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TxtRol" Foreground="White" FontSize="11" Opacity="0.7"/>
                    <Button Content="Cerrar Sesión" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Margin="0,10,0,0"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Área de Contenido -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>