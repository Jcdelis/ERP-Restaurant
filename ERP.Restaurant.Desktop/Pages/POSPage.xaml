<Page x:Class="ERP.Restaurant.Desktop.POSPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="🛒 Punto de Venta" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!-- LECTOR DE CÓDIGO DE BARRAS (Debe tener x:Name="TxtBarcode") -->
            <TextBox x:Name="TxtBarcode" 
                     materialDesign:HintAssist.Hint="Escanear Código de Barras (Enter)" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                     Height="50" Margin="0,0,0,15"
                     KeyDown="TxtBarcode_KeyDown"/>
                     
            <WrapPanel Name="PanelProductos">
                <Button Content="Lomo Saltado&#10;S/ 35.00" Width="140" Height="90" Margin="5" 
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="AgregarLomo"/>
                <Button Content="Ceviche&#10;S/ 40.00" Width="140" Height="90" Margin="5"
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="AgregarCeviche"/>
                <Button Content="Inca Kola&#10;S/ 8.00" Width="140" Height="90" Margin="5"
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="AgregarInca"/>
            </WrapPanel>
        </StackPanel>
        
        <StackPanel Grid.Column="1">
            <TextBlock Text="Comanda Actual" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid Name="GridCarrito" AutoGenerateColumns="False" Height="350" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="50"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Name="TxtTotal" Text="Total: S/ 0.00" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Right" Margin="0,15,0,10"/>
            <Button Content="💳 COBRAR E IMPRIMIR" Height="55" FontSize="18"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="Green" Foreground="White" Click="PagarVenta"/>
        </StackPanel>
    </Grid>
</Page>