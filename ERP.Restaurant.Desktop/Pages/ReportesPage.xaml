<Page x:Class="ERP.Restaurant.Desktop.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="📊 Reportes y KPIs" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Abre el Dashboard Visual en tu navegador:" FontSize="14" Margin="0,0,0,10"/>
            <Button Content="🌐 Abrir Dashboard Web (http://localhost:5000/dashboard.html)" 
                    Height="50" FontSize="16" Click="AbrirDashboard"/>
            <TextBlock Text="O prueba los endpoints en Swagger:" FontSize="14" Margin="0,20,0,10"/>
            <Button Content="🔗 Abrir Swagger" Height="40" Click="AbrirSwagger"/>
        </StackPanel>
    </Grid>
</Page>